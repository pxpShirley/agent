{
  "name": "smart-service-agent",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "eval": "tsx scripts/run-evals.ts",
    "test": "tsx scripts/due-parse-probe.ts && tsx scripts/chat-stream-probe.ts && tsx scripts/dashboard-logic-probe.ts && tsx scripts/reminder-steps-probe.ts && tsx scripts/recur-probe.ts && tsx scripts/proactive-action-probe.ts && tsx scripts/xinglan-performance-probe.ts && tsx scripts/memory-select-probe.ts && tsx scripts/ui-scroll-probe.ts && tsx scripts/css-hygiene-probe.ts",
    "test:live": "node scripts/memory-control-probe.mjs && tsx scripts/artifact-version-probe.ts && tsx scripts/memory-merge-probe.ts"
  },
  "dependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "better-sqlite3": "^12.6.2",
    "express": "^4.18.2",
    "markdown-it": "^14.3.0",
    "lucide-react": "^0.563.0",
    "nodemailer": "^9.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "playwright": "^1.48.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
