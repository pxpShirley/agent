# ============================================================
# 星澜 AI 生活管家 · 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交。
# ============================================================

# ---- 智能体运行时凭证（任一存在即启用真实 Agent 主循环）----
# 三选一：CodeBuddy API Key / Auth Token，或 Anthropic API Key
CODEBUDDY_API_KEY=
CODEBUDDY_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# ---- 离线演示模式（不接任何大模型也能跑通完整管线）----
# 设为 1 / true / yes 时，使用本地规则化 Mock 智能体（记提醒/记忆/心情/联网检索均真实落库）
MOCK_AGENT=1

# ---- 默认模型 ----
DEFAULT_MODEL=claude-sonnet-4

# ---- 联网检索（web_lookup 工具）----
# 可选：brave / tavily / serpapi / duckduckgo(默认)
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=

# ---- 主动调度（晨报 / 到期提醒 / 周复盘）----
# 设为 1 且已配置 SDK 时，由调度器驱动 Agent 生成主动卡片
AGENT_BRIEFING=1

# ---- 服务端口 ----
PORT=3000
